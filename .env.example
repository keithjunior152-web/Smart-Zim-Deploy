# ──────────────────────────────────────────────────────────────────────────────
# SmartZim — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Session ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-byte-hex-string

# ── Supabase Storage ───────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# Use the SERVICE ROLE key (not the anon key) — server-side only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage bucket names (create these in Supabase → Storage)
SUPABASE_PUBLIC_BUCKET=smartzim-public       # for publicly accessible files (notes, papers, profile photos)
SUPABASE_PRIVATE_BUCKET=smartzim-private     # for private uploads (assignment submissions, etc.)

# ── Google Gemini AI ───────────────────────────────────────────────────────────
# From: https://aistudio.google.com/app/apikey  (free tier available, no billing required to start)
# Used by: ZimTutor chat, daily quiz generation, AI study plan, document summariser
GEMINI_API_KEY=AIza...

# ── Email (transactional) ──────────────────────────────────────────────────────
# Optional — if not set, the app still works; approval/rejection emails are skipped.
# Works with any SMTP provider: Gmail, Resend, SendGrid, Brevo, etc.
#
# Gmail quick-start:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char App Password>
#   (Enable "App Passwords" in your Google Account → Security settings)
#
# Resend (recommended for production — generous free tier):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465
#   SMTP_USER=resend           SMTP_PASS=<your Resend API key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@smartzim.co.zw
SMTP_PASS=your-app-password
SMTP_FROM=SmartZim <noreply@smartzim.co.zw>

# ── Stripe (international card payments) ──────────────────────────────────────
# Sign up at stripe.com → Developers → API keys
# Test keys start with sk_test_ / pk_test_  |  Live keys: sk_live_ / pk_live_
# After setting STRIPE_SECRET_KEY, run: stripe listen --forward-to localhost:8080/api/payments/stripe/webhook
# to get your STRIPE_WEBHOOK_SECRET for local testing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_ prefix exposes this to the browser (safe — it's a public key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── PayPal (optional — auto-activation on payment) ────────────────────────────
# Sign up at developer.paypal.com → Apps & Credentials → Create App
# Use sandbox credentials for testing, live credentials for production.
PAYPAL_CLIENT_ID=AX...
PAYPAL_CLIENT_SECRET=EG...
PAYPAL_ENV=sandbox   # change to "production" when going live
# VITE_ prefix exposes clientId to browser (safe — it's a public identifier)
VITE_PAYPAL_CLIENT_ID=AX...

# ── Frontend (Vite build-time) ─────────────────────────────────────────────────
# Public API base URL — must end with /api
# Local: http://localhost:3001/api
# Production: https://smartzim.vercel.app/api  (or your custom domain)
VITE_API_BASE_URL=http://localhost:3001

# Site origin for SEO/SSR meta tags
SITE_ORIGIN=https://smartzim.vercel.app

# ── Server runtime ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
