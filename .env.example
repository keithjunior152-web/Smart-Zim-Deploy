# ──────────────────────────────────────────────────────────────────────────────
# SmartZim — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Session ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-byte-hex-string

# ── Supabase Storage ───────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# Use the SERVICE ROLE key (not the anon key) — server-side only, never expose to clients
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage bucket names (create these in Supabase → Storage)
SUPABASE_PUBLIC_BUCKET=smartzim-public       # for publicly accessible files (notes, papers, profile photos)
SUPABASE_PRIVATE_BUCKET=smartzim-private     # for private uploads (assignment submissions, etc.)

# ── Anthropic AI ───────────────────────────────────────────────────────────────
# From: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Frontend (Vite build-time) ─────────────────────────────────────────────────
# Public API base URL — must end with /api
# Local: http://localhost:3001/api
# Production: https://smartzim.vercel.app/api  (or your custom domain)
VITE_API_BASE_URL=http://localhost:3001

# Site origin for SEO/SSR meta tags
SITE_ORIGIN=https://smartzim.vercel.app

# ── Server runtime ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
